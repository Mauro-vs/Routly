NODE_ENV=development
# El puerto de la gateway: la única puerta de entrada de Routly
PORT=4000

# HTTPS con el certificado de certs/: npm run certs (autofirmado) o el de mkcert (ver el README).
# false solo para depurar
HTTPS=true
# TLS_CERT_FILE=certs/cert.pem
# TLS_KEY_FILE=certs/key.pem
# Opcional: un puerto HTTP que solo redirige a HTTPS (sin definir, no se abre)
# HTTP_PORT=8080

# La web y el panel, cada uno en su nombre. Los *.localhost apuntan a este equipo sin tocar el
# archivo hosts, y cada nombre guarda sus cookies: cada frontal tiene su propia sesión
WEB_HOST=routly.localhost
PANEL_HOST=panel.routly.localhost
# En desarrollo, su ng serve (el live reload va por WebSocket a través de la gateway)
WEB_URL=http://localhost:4300
PANEL_URL=http://localhost:4200
# O la carpeta de su build (ng build), que sirve la propia gateway. Si se pone, manda sobre la URL
# WEB_DIST=../moto-routes-web/dist/moto-routes-web/browser
# PANEL_DIST=../moto-routes-dashboard/dist/moto-routes-dashboard/browser

# Dónde está cada servicio, por la red interna. El navegador nunca habla con ellos directamente
API_URL=http://127.0.0.1:3000
AUTH_URL=http://127.0.0.1:3002
AI_URL=http://127.0.0.1:3001

# Milisegundos sin recibir nada de un servicio antes de responder 504. La IA tiene el suyo, más
# largo: los textos IA tardan hasta ~75 s. Es un plazo de inactividad: el chat en streaming no caduca
UPSTREAM_TIMEOUT_MS=15000
AI_TIMEOUT_MS=90000
# Lo que espera GET /gateway/ready al /health de cada servicio
HEALTH_TIMEOUT_MS=2000

# El token en la puerta: la clave pública de auth. Sin definir, el JWKS de AUTH_URL. Emisor y
# audiencia, los mismos que en moto-routes-auth y la API
# AUTH_JWKS_URL=http://127.0.0.1:3002/auth/.well-known/jwks.json
JWT_ISSUER=routly-auth
JWT_AUDIENCE=routly

# Límite de peticiones por IP para /api, /auth y /ai (los frontales no cuentan)...
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# ...y otro más estricto para lo que gasta cuota de la IA: el chat y los textos IA
AI_RATE_LIMIT_WINDOW_MS=600000
AI_RATE_LIMIT_MAX=30

# Tope del cuerpo de una petición (413). Cada servicio tiene además el suyo
MAX_BODY_BYTES=1048576

# Registro de acceso: una línea JSON por petición, sin query, cookies ni tokens. Sin definir: sí
# ACCESS_LOG=true
