NODE_ENV=development
# El puerto de la gateway: la única puerta de entrada de Routly
PORT=4000

# Dónde está cada servicio, por la red interna. El navegador nunca habla con ellos directamente
API_URL=http://127.0.0.1:3000
AUTH_URL=http://127.0.0.1:3002
AI_URL=http://127.0.0.1:3001

# Milisegundos sin recibir nada de un servicio antes de responder 504. La IA tiene el suyo, más
# largo: los textos IA tardan hasta ~75 s. Es un plazo de inactividad: el chat en streaming no caduca
UPSTREAM_TIMEOUT_MS=15000
AI_TIMEOUT_MS=90000
# Lo que espera GET /gateway/ready al /health de cada servicio
HEALTH_TIMEOUT_MS=2000

# Tope del cuerpo de una petición (413). Cada servicio tiene además el suyo
MAX_BODY_BYTES=1048576

# Registro de acceso: una línea JSON por petición, sin query, cookies ni tokens. Sin definir: sí
# ACCESS_LOG=true
