{
  "name": "moto-routes-gateway",
  "version": "1.0.0",
  "description": "API gateway de Routly: la única puerta de entrada, con HTTPS. Reparte /api, /auth y /ai a su servicio y sirve la web y el panel, cada uno en su nombre",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "certs": "node scripts/generate-certs.js",
    "test": "node --test"
  },
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "http-proxy-middleware": "^3.0.11",
    "jose": "^6.2.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "selfsigned": "^5.5.0"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      ".env"
    ],
    "ext": "js,json"
  }
}
