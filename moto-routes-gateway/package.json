{
  "name": "moto-routes-gateway",
  "version": "1.0.0",
  "description": "API gateway de Routly: la única puerta de entrada. Reparte /api, /auth y /ai a su servicio, con un id por petición y un registro común",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test"
  },
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "http-proxy-middleware": "^3.0.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      ".env"
    ],
    "ext": "js,json"
  }
}
