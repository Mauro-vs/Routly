NODE_ENV=development
PORT=3001
# Número de proxies delante. 1 con la API gateway (moto-routes-gateway, https://routly.localhost:4000):
# así el límite de peticiones cuenta la IP real del cliente. 0 si nadie va delante
TRUST_PROXY=1

# La API de Routly. El servidor de IA solo usa su parte pública (/api/shop) y nunca toca MongoDB
ROUTLY_API_URL=http://localhost:3000/api
# Milisegundos que se espera a la API, a Open-Meteo y a OpenStreetMap
UPSTREAM_TIMEOUT_MS=10000

# El proveedor de IA: groq (por defecto), gemini u openrouter. Los tres son gratis con límites y
# hablan la API de OpenAI, así que solo cambia esto y la clave:
# - groq: https://console.groq.com/keys (gratis, sin tarjeta; el más rápido)
# - gemini: https://aistudio.google.com/apikey (gratis, sin tarjeta)
# - openrouter: https://openrouter.ai/keys (solo los modelos ":free", que cambian a menudo)
AI_PROVIDER=groq
# La clave del proveedor. Vacía, el servidor arranca igual: el tiempo y las paradas funcionan, y
# los textos IA y el chat responden 503
AI_API_KEY=
# Opcional: modelos separados por comas (el primero es el principal y el resto, los de reserva si
# está saturado). Vacío = los del proveedor: en Groq, openai/gpt-oss-120b y qwen/qwen3.8-27b
AI_MODELS=
# Opcional: los modelos del agente de resumen de opiniones (vacío = los de AI_MODELS). Mejor el grande
AI_MODELS_REVIEWS=
# Opcional: clave gratuita de Geoapify (https://myprojects.geoapify.com, 3000 peticiones al día, sin
# tarjeta) para los restaurantes, miradores y gasolineras del mapa. Sin ella se usan Photon y Overpass,
# que son gratis sin clave pero a menudo no responden
GEOAPIFY_API_KEY=
# Milisegundos que se espera a la IA y tokens como mucho por respuesta
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=1200
# La web pública: OpenRouter la enseña en sus estadísticas de uso (los demás no la usan)
SITE_URL=http://localhost:4300
