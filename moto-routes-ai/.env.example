NODE_ENV=development
PORT=3001
# Número de proxies delante (Nginx, un PaaS, el futuro API gateway). 0 sin proxy
TRUST_PROXY=0

# La API de Routly. El servidor de IA solo usa su parte pública (/api/shop) y nunca toca MongoDB
ROUTLY_API_URL=http://localhost:3000/api
# Milisegundos que se espera a la API, a Open-Meteo y a OpenStreetMap
UPSTREAM_TIMEOUT_MS=10000

# Clave de OpenRouter: https://openrouter.ai/keys. Es gratis y no hace falta meter crédito para
# los modelos ":free". En https://openrouter.ai/settings/privacy activa los modelos gratuitos
# ("Enable free endpoints that may train on inputs"): si no, responden 404.
# Vacía, el servidor arranca igual: el tiempo y las paradas funcionan, y los textos IA y el chat
# responden 503
OPENROUTER_API_KEY=
# Modelos separados por comas: el primero es el principal y el resto, los de reserva (si el primero
# falla, OpenRouter pasa al siguiente). Todos gratuitos (":free") y con herramientas (el chat las
# usa). Los gratuitos se retiran a menudo: al arrancar se miran en el catálogo de OpenRouter y, si
# alguno ya no está, se cambia solo por otro gratuito con herramientas (sale en la consola).
# Para elegirlos a mano: https://openrouter.ai/models?max_price=0&supported_parameters=tools
# Los gratuitos tienen un límite de peticiones al día (50 sin crédito en la cuenta)
AI_MODELS=meta-llama/llama-3.3-70b-instruct:free,mistralai/mistral-small-3.2-24b-instruct:free
# Milisegundos que se espera a la IA y tokens como mucho por respuesta
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=1200
# La web pública: OpenRouter la enseña en sus estadísticas de uso
SITE_URL=http://localhost:4300
