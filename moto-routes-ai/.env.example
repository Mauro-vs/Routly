NODE_ENV=development
PORT=3001
# Número de proxies delante (Nginx, un PaaS, el futuro API gateway). 0 sin proxy
TRUST_PROXY=0

# La API de Routly. El servidor de IA solo usa su parte pública (/api/shop) y nunca toca MongoDB
ROUTLY_API_URL=http://localhost:3000/api
# Milisegundos que se espera a la API, a Open-Meteo y a OpenStreetMap
UPSTREAM_TIMEOUT_MS=10000

# Clave de OpenRouter: https://openrouter.ai/keys (ponle un límite de gasto en su panel).
# Vacía, el servidor arranca igual: el tiempo y las paradas funcionan, y los textos IA y el chat
# responden 503
OPENROUTER_API_KEY=
# Modelos separados por comas: el primero es el principal y el resto, los de reserva (si el primero
# falla, OpenRouter pasa al siguiente). Comprueba los nombres en https://openrouter.ai/models.
# Para desarrollar sin gastar, uno gratuito: los que terminan en :free
AI_MODELS=google/gemini-2.5-flash,x-ai/grok-4-fast
# Milisegundos que se espera a la IA y tokens como mucho por respuesta
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=1200
# La web pública: OpenRouter la enseña en sus estadísticas de uso
SITE_URL=http://localhost:4300
