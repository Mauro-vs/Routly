NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/moto_routes
# Orígenes permitidos, separados por comas. CORS solo los usa con NODE_ENV=production;
# la comprobación CSRF de la cookie de sesión, siempre (y en desarrollo acepta además localhost)
CORS_ORIGIN=http://localhost:4200
# Secreto con el que se firman los JWT (HS256). Obligatorio; en producción, 32 caracteres
# como mínimo. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Caducidad de los tokens: 7d en desarrollo; en producción se recomienda 1h
JWT_EXPIRES_IN=7d
# Número de proxies delante de la API (Nginx, Caddy, el de un PaaS). 0 sin proxy, también en
# producción; 1 si el HTTPS lo termina un proxy. Sin proxy, no lo subas: cualquiera podría
# inventarse su IP (X-Forwarded-For) y saltarse el límite de intentos del login
TRUST_PROXY=0
# Cookie de sesión. COOKIE_SECURE: true o false (sin definir, true en producción); con Secure
# se llama __Secure-routly_session. COOKIE_SAMESITE: strict (por defecto) o lax
# COOKIE_SECURE=true
# COOKIE_SAMESITE=strict
