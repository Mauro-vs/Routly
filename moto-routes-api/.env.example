NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/moto_routes
# Solo se usa con NODE_ENV=production: orígenes permitidos por CORS, separados por comas
CORS_ORIGIN=http://localhost:4200
# Secreto con el que se firman los JWT (HS256). Obligatorio; en producción, 32 caracteres
# como mínimo. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Caducidad de los tokens: 7d en desarrollo; en producción se recomienda 1h
JWT_EXPIRES_IN=7d
