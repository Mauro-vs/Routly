NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/moto_routes
# Orígenes permitidos, separados por comas. CORS solo los usa con NODE_ENV=production;
# la comprobación CSRF de la cookie de sesión, siempre (y en desarrollo acepta además localhost)
CORS_ORIGIN=http://localhost:4200,https://panel.routly.localhost:4000,https://routly.localhost:4000
# JWKS del servicio de auth (moto-routes-auth, puerto 3002). La API ya no firma tokens: solo
# comprueba los RS256 que firma auth con su clave pública. Sin definir, en desarrollo usa
# http://localhost:3002/auth/.well-known/jwks.json; en producción es obligatorio
AUTH_JWKS_URL=http://localhost:3002/auth/.well-known/jwks.json
# Emisor y audiencia esperados en el token; tienen que coincidir con los de auth
# JWT_ISSUER=routly-auth
# JWT_AUDIENCE=routly
# Número de proxies delante de la API. 1 con la API gateway (moto-routes-gateway), que termina el
# HTTPS: así la API ve el protocolo y el nombre reales (X-Forwarded-Proto y -Host) y la comprobación
# CSRF acepta https://panel.routly.localhost:4000. 0 si nadie va delante: si no, cualquiera podría
# inventarse su IP (X-Forwarded-For) y falsear la IP que queda en los registros (req.ip)
TRUST_PROXY=1
# Cookie de sesión (la pone el servicio de auth; la API solo la lee). COOKIE_SECURE: true o
# false (sin definir, true en producción); con Secure se llama __Secure-routly_session.
# Tiene que valer lo mismo que en moto-routes-auth
# COOKIE_SECURE=true
# Fotos de las opiniones (config/uploads.js). UPLOADS_DIR: carpeta de las subidas, relativa a
# moto-routes-api o absoluta (por defecto, uploads, ignorada por git). La web ya manda la foto
# reducida a WebP; la API corta en REVIEW_PHOTO_MAX_BYTES y admite REVIEW_PHOTOS_MAX por opinión
# UPLOADS_DIR=uploads
# REVIEW_PHOTO_MAX_BYTES=1048576
# REVIEW_PHOTOS_MAX=4
