NODE_ENV=development
PORT=3002
# Número de proxies delante. 1 con la API gateway (moto-routes-gateway): así el límite de intentos
# cuenta la IP real y la comprobación CSRF acepta https://routly.localhost:4000 (sin él, el login por
# la gateway da 403). 0 si nadie va delante: si no, cualquiera podría inventarse su IP (X-Forwarded-For)
# y saltarse el límite de intentos
TRUST_PROXY=1
# La misma base de datos que la API: los usuarios y los roles son suyos
MONGODB_URI=mongodb://localhost:27017/moto_routes
# Orígenes del panel y la web, separados por comas: CORS en producción y la comprobación CSRF
# (en desarrollo, además, cualquier localhost)
CORS_ORIGIN=http://localhost:4200,http://localhost:4300,https://panel.routly.localhost:4000,https://routly.localhost:4000

# Quién firma los tokens y para quién. La API, la IA y la gateway comprueban los dos
JWT_ISSUER=routly-auth
JWT_AUDIENCE=routly
# Vida del token de acceso (corto) y del refresh. Valen 900, 15m, 1h, 7d...
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# La clave privada RSA con la que se firma. En desarrollo: npm run keys (crea keys/private.pem, que no
# se sube). En producción, mejor la clave en JWT_PRIVATE_KEY (PEM con \n escapados) que un archivo
# JWT_PRIVATE_KEY_FILE=keys/private.pem
# JWT_PRIVATE_KEY=
# Al rotar la clave: la pública anterior, para que sus tokens sigan valiendo hasta que caduquen
# JWT_PREVIOUS_PUBLIC_KEY_FILE=keys/previous-public.pem

# Cookies. COOKIE_SECURE: true o false (sin definir, true en producción, y en producción no puede ser
# false); con Secure se llaman __Secure-routly_session y __Secure-routly_refresh. COOKIE_SAMESITE: strict o lax
# COOKIE_SECURE=true
# COOKIE_SAMESITE=strict
# El token de acceso también en el body del login (Swagger, Postman). Sin definir: sí, salvo en producción
# TOKEN_IN_BODY=true
