{
  "name": "moto-routes-auth",
  "version": "1.0.0",
  "description": "Servicio de autenticación de Routly: login, registro y sesiones. El único que firma tokens (RS256) y publica su clave pública (JWKS)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "keys": "node scripts/generate-keys.js",
    "test": "node --test"
  },
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "mongoose": "^9.10.2",
    "morgan": "^1.12.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      ".env"
    ],
    "ext": "js,json"
  }
}
